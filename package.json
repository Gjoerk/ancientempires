{
  "name": "kingsfall",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "tsx watch packages/server/src/index.ts",
    "dev:client": "vite packages/client",
    "start": "tsx packages/server/src/index.ts",
    "build": "vite build packages/client",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/shared/src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
